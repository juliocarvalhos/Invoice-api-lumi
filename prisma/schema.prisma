// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dados extraídos do LLM
  clientNumber    String
  referenceMonth  String // Ex: "SET/2024"

  // Energia Elétrica
  energiaEletricaQtd   Float
  energiaEletricaValor Float

  // Energia SCEE s/ICMS
  energiaSceeeQtd   Float
  energiaSceeeValor Float

  // Energia Compensada GD I
  energiaCompensadaQtd   Float
  energiaCompensadaValor Float

  // Contrib Ilum Pública Municipal
  contribIlumPublicaValor Float

  // Variáveis calculadas
  consumoEnergiaEletricaKwh Float // energiaEletricaQtd + energiaSceeeQtd
  energiaCompensadaKwh      Float // energiaCompensadaQtd
  valorTotalSemGd           Float // energiaEletricaValor + energiaSceeeValor + contribIlumPublicaValor
  economiaGd                Float // energiaCompensadaValor (positivo)

  @@unique([clientNumber, referenceMonth])
  @@index([clientNumber])
  @@index([referenceMonth])
}
