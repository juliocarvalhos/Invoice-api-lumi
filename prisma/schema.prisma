generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id                           String   @id @default(uuid())
  consumo_energia_kwh          Float
  contrib_ilum_publica         Float
  created_at                   DateTime @default(now())
  economia_gd                  Float
  energia_compensada_kwh       Float
  energia_compensada_total_kwh Float
  energia_compensada_valor     Float
  energia_eletrica_kwh         Float
  energia_eletrica_valor       Float
  energia_sceee_kwh            Float
  energia_sceee_valor          Float
  mes_referencia               String
  numero_cliente               String
  valor_total_sem_gd           Float

  @@index([numero_cliente])
  @@index([mes_referencia])
  @@index([numero_cliente, mes_referencia])
}
