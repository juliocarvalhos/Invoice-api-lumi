// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id                          String   @id @default(uuid())
  numero_cliente              String
  mes_referencia              String   // Ex: "SET/2024"

  // Dados brutos extraídos pelo LLM
  energia_eletrica_kwh        Float
  energia_eletrica_valor      Float
  energia_sceee_kwh           Float
  energia_sceee_valor         Float
  energia_compensada_kwh      Float
  energia_compensada_valor    Float
  contrib_ilum_publica        Float

  // Variáveis calculadas pelo sistema
  consumo_energia_kwh         Float    // energia_eletrica_kwh + energia_sceee_kwh
  energia_compensada_total_kwh Float   // = energia_compensada_kwh
  valor_total_sem_gd          Float    // energia_eletrica_valor + energia_sceee_valor + contrib_ilum_publica
  economia_gd                 Float    // = energia_compensada_valor (positivo)

  created_at                  DateTime @default(now())

  @@index([numero_cliente])
  @@index([mes_referencia])
  @@index([numero_cliente, mes_referencia])
}
